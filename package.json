{
  "name": "celoht-smart-contracts",
  "version": "0.1.0",
  "description": "Production-grade Celo protocol infrastructure for CeloHT (Celo-HaiTi) — Agent Network, Service Payments, Education, Reforestation, Governance.",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:testnet": "hardhat run scripts/deployAll.ts --network alfajores",
    "deploy:mainnet": "hardhat run scripts/deployAll.ts --network celo",
    "verify:testnet": "hardhat run scripts/verifyContracts.ts --network alfajores",
    "verify:mainnet": "hardhat run scripts/verifyContracts.ts --network celo",
    "export:deployment": "hardhat run scripts/exportDeployment.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "chai": "^4.4.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "ethers": "^6.13.1",
    "hardhat": "^2.22.5",
    "hardhat-gas-reporter": "^2.2.0",
    "prettier": "^3.3.2",
    "prettier-plugin-solidity": "^1.3.1",
    "solidity-coverage": "^0.8.12",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.5.2"
  }
}
