# Copy this file to .env and fill in real values.
# NEVER commit .env. NEVER commit private keys.

# Deployer private key (testnet/mainnet). Use a dedicated deployment key, not a personal wallet.
DEPLOYER_PRIVATE_KEY=

# RPC endpoints
ALFAJORES_RPC_URL=https://alfajores-forno.celo-testnet.org
# Celo's officially recommended Alfajores replacement (see NETWORK STATUS ADVISORY below)
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
CELO_RPC_URL=https://forno.celo.org

# Celoscan / block explorer API key for source verification
CELOSCAN_API_KEY=

# USDm token address per network — MUST be independently verified before use.
# Do NOT invent these. Leave blank until confirmed from an authoritative source.
#
# CELO MAINNET — VERIFIED 2026-08-30 via CeloScan (celoscan.io/token/0x765de816845861e75a25fca122bb6898b8b1282a):
# This is the same proxy contract formerly known as cUSD, rebranded "Mento Dollar (USDm)" by Mento.
# Decimals: 18. Re-verify independently before any mainnet deployment — do not trust this comment blindly.
USDM_ADDRESS_CELO=0x765DE816845861e75A25fCA122bb6898B8B1282a
USDM_DECIMALS_CELO=18

# NETWORK STATUS ADVISORY (verified 2026-08-30 via docs.celo.org/tooling/testnets/celo-sepolia
# and the Celo Forum announcement "Introducing Celo Sepolia"): Celo has deprecated Alfajores
# in favor of "Celo Sepolia Testnet" (chain ID 11142220) following the Holesky sunset on
# 2025-09-30. Multiple third-party providers (Tatum, NOAH) already treat Alfajores as fully
# decommissioned. However, at verification time, Alfajores CeloScan still showed live,
# recent transaction activity and docs.celo.org/network/alfajores still described it as
# Celo's "primary public developer testnet" (with a banner pointing to Sepolia). This is a
# genuine, unresolved conflict between sources — confirm current status yourself at
# docs.celo.org/network before relying on either testnet. See docs/DEPLOYMENT.md.

# ALFAJORES TESTNET — VERIFIED 2026-08-30 via CeloScan Alfajores
# (alfajores.celoscan.io/token/0x874069fa1eb16d44d622f2e0ca25eea172369bc1) and Celo's own
# official docs (docs.celo.org, ContractKit→viem migration example, which uses this exact
# address as `USDmAddress`). Same proxy contract (StableTokenProxy), 18 decimals, still
# labeled "Celo Dollar (cUSD)" on the Alfajores explorer at verification time (the USDm
# rebrand shown on Mainnet CeloScan had not visibly propagated to the Alfajores UI as of
# this check). Re-verify before relying on it for anything beyond local/testnet dev — and
# note the Alfajores deprecation advisory above.
USDM_ADDRESS_ALFAJORES=0x874069Fa1Eb16D44d622F2e0Ca25eeA172369bC1

# CELO SEPOLIA TESTNET — VERIFIED FROM THE Celo Sepolia Blockscout explorer (USDm search
# result, contract name "Mento Dollar", symbol "USDm") using the live public explorer API.
# This is the official USDm token for Sepolia, and it is distinct from the Alfajores and
# Mainnet addresses. Re-verify before any production-sensitive use.
USDM_ADDRESS_CELO_SEPOLIA=0xdE9e4C3ce781b4bA68120d6261cbad65ce0aB00b

# Treasury addresses
#
# OPTION A (current, intentional configuration): all four treasury categories
# point at the same confirmed CeloHT Treasury Safe. This is a deliberate
# decision, not a missing value — see docs/ARCHITECTURE.md "Treasury" section.
# Each contract (CeloHTAgentRegistry, CeloHTServicePayments, CeloHTEducation,
# CeloHTReforestation, CeloHTGovernance) stores its own treasury address as an
# independently updatable state variable (via TREASURY_ADMIN_ROLE), so the
# Maintainer Council can split these into separate Safes later via a single
# setTreasury() call per contract — no contract redesign or redeployment
# required.
GENERAL_TREASURY=0xd856e0599cc49C9cef6C358d2c2f064112A6b384
EDUCATION_TREASURY=0xd856e0599cc49C9cef6C358d2c2f064112A6b384
REFORESTATION_TREASURY=0xd856e0599cc49C9cef6C358d2c2f064112A6b384
GOVERNANCE_TREASURY=0xd856e0599cc49C9cef6C358d2c2f064112A6b384

# Gas reporting
REPORT_GAS=false
COINMARKETCAP_API_KEY=
