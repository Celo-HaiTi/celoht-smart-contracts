# Copy this file to .env and fill in real values.
# NEVER commit .env. NEVER commit private keys.

# Deployer private key. Store the real value only in GitHub Actions as PRIVATE_KEY.
PRIVATE_KEY=

# RPC endpoints
# Store the real RPC URL only in GitHub Actions as SEPOLIA_RPC_URL.
SEPOLIA_RPC_URL=

# Optional Blockscout API key for source verification
BLOCKSCOUT_API_KEY=

# Celo Sepolia USDm address. Re-verify before deployment.
USDM_ADDRESS_CELO_SEPOLIA=0xdE9e4C3ce781b4bA68120d6261cbad65ce0aB00b

# Treasury addresses
#
# Supply separately confirmed Celo Sepolia treasury/Safe addresses through
# secure GitHub Environment secrets. Do not assume the four addresses match.
GENERAL_TREASURY=
EDUCATION_TREASURY=
REFORESTATION_TREASURY=
GOVERNANCE_TREASURY=

# Gas reporting
REPORT_GAS=false
COINMARKETCAP_API_KEY=
