{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ERC-8004 Agent Registration File",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "name",
    "description",
    "image",
    "services",
    "x402Support",
    "active",
    "registrations"
  ],
  "properties": {
    "type": {
      "const": "https://eips.ethereum.org/EIPS/eip-8004#registration-v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "endpoint"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "endpoint": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "x402Support": {
      "type": "boolean"
    },
    "active": {
      "type": "boolean"
    },
    "registrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agentId", "agentRegistry"],
        "properties": {
          "agentId": {
            "type": "integer",
            "minimum": 0
          },
          "agentRegistry": {
            "type": "string",
            "pattern": "^eip155:[0-9]+:0x[0-9a-fA-F]{40}$"
          }
        },
        "additionalProperties": true
      }
    },
    "supportedTrust": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
